# AI service configuration. Overrides are read from the environment.
# AI_SERVICE_TOKEN is a shared secret between the Node backend and this service.
AI_SERVICE_PORT=8000
AI_SERVICE_TOKEN=replace-with-a-shared-devpulse-secret

# LLM provider (ai-service drives an OpenAI-compatible chat-completions API).
# When AI_API_KEY is empty the service runs in deterministic mock mode (it still
# calls the real Node internal tools so evidence + tool audit are realistic).
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_DEEP_MODEL=gpt-4o
# AI_API_KEY=
AI_MAX_TOOL_CALLS=25
AI_TIMEOUT_MS=120000
AI_TEMPERATURE=0.2
# Approximate cost guardrail (tokens spent across tool context).
AI_BUDGET_TOKENS=8000
AI_EST_OUTPUT_TOKENS=1500

# Node API base URL used by AI tools to fetch scoped investigation context.
NODE_API_URL=http://localhost:4000