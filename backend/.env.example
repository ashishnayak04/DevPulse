# Database
DATABASE_URL=postgresql://devpulse:devpulse@localhost:5432/devpulse

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secrets (generate with: openssl rand -base64 32)
JWT_SECRET=replace-with-a-random-secret
JWT_REFRESH_SECRET=replace-with-another-random-secret

# SMTP (email alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME=DevPulse Alerts
SMTP_FROM_EMAIL=your-email@gmail.com

# Server
PORT=4000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Admin account (created by: npm run db:seed)
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# OAuth (Feature: social login)
# Google console: create OAuth client, redirect URI: {BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub developer settings, callback URL: {BASE_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public base URL of the backend (used to build OAuth callback URLs)
BASE_URL=http://localhost:4000

# DevPulse 2.0 — AI investigation service (all optional; feature is inactive when unset)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=replace-with-a-shared-devpulse-secret
AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_DEEP_MODEL=gpt-4o
# AI_API_KEY=
AI_MAX_TOOL_CALLS=25
AI_TIMEOUT_MS=120000
AI_TEMPERATURE=0.2

# DevPulse 2.0 — GitHub intelligence (Phase 2; safe to leave blank)
# GITHUB_TOKEN=github_pat_...
